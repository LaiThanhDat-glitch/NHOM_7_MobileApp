<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rescue_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_splash_mark"
        android:contentDescription="@string/app_name"
        android:elevation="2dp"
        android:padding="22dp"
        android:src="@drawable/ic_splash_leaf" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/app_name"
        android:textColor="@color/rescue_splash_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/launch_loading_message"
        android:textColor="@color/rescue_on_surface_variant"
        android:textSize="14sp" />

    <ProgressBar
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="28dp"
        android:contentDescription="@string/loading_content_description"
        android:indeterminate="true"
        android:indeterminateTint="@color/rescue_splash_green" />
</LinearLayout>
