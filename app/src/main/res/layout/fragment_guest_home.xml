<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/rescue_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/space_md">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/home_eyebrow" android:textStyle="bold"
            android:textColor="@color/rescue_primary" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_title" android:textStyle="bold"
            android:textColor="@color/rescue_on_surface" android:textSize="32sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_subtitle" android:textColor="@color/rescue_on_surface_variant"
            android:textSize="15sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="@dimen/space_md">
            <com.google.android.material.button.MaterialButton android:id="@+id/searchButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/discovery_search_action" />
            <com.google.android.material.button.MaterialButton android:id="@+id/refreshHomeButton"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:text="@string/refresh_action" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/locationHomeButton"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/home_use_location" />
            <com.google.android.material.button.MaterialButton android:id="@+id/loginButton"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/login_action" />
            <com.google.android.material.button.MaterialButton android:id="@+id/profileButton"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/profile_action" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cartHomeButton"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/open_cart_action" />
        </LinearLayout>
        <TextView android:id="@+id/homeMessage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/rescue_on_surface_variant"
            android:textSize="13sp" />
        <ProgressBar android:id="@+id/homeProgress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:visibility="gone" />

        <TextView style="@style/TextAppearance.Material3.TitleLarge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Banner giải cứu" />
        <LinearLayout android:id="@+id/bannerSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView style="@style/TextAppearance.Material3.TitleLarge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="🔴 CẦN GIẢI CỨU GẤP" />
        <LinearLayout android:id="@+id/criticalSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView style="@style/TextAppearance.Material3.TitleLarge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="🚚 ĐIỂM GIẢI CỨU DI ĐỘNG GẦN BẠN" />
        <LinearLayout android:id="@+id/mobileSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView style="@style/TextAppearance.Material3.TitleLarge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="📍 ĐIỂM GIẢI CỨU CỐ ĐỊNH GẦN BẠN" />
        <LinearLayout android:id="@+id/fixedSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView style="@style/TextAppearance.Material3.TitleLarge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="⏰ SẮP HẾT THỜI GIAN" />
        <LinearLayout android:id="@+id/endingSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView style="@style/TextAppearance.Material3.TitleLarge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="💰 MUA NHIỀU GIÁ TỐT HƠN" />
        <LinearLayout android:id="@+id/valueSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView style="@style/TextAppearance.Material3.TitleLarge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="🌱 CHIẾN DỊCH ĐANG DIỄN RA" />
        <LinearLayout android:id="@+id/campaignSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView style="@style/TextAppearance.Material3.TitleLarge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="CATEGORY" />
        <LinearLayout android:id="@+id/categorySection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView style="@style/TextAppearance.Material3.TitleLarge" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="FEED GIẢI CỨU" />
        <LinearLayout android:id="@+id/feedSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
